# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/campus_fix
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Used ONLY by the one-time command: python create_admin.py
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Frontend address (used in invitation / reset links)
FRONTEND_URL=http://localhost:5173
# Image storage: local folder by default (see README for free-tier cloud note)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Email (optional; without it invitation links are printed in the API console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
